{
  "name": "pi-toolkit",
  "version": "0.1.0",
  "description": "Pi toolkit with Janitor cleanup and blocking serial worker/reviewer delegation.",
  "type": "module",
  "keywords": ["pi-package"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edepree/pi-toolkit.git"
