{
  "name": "pi-toolkit",
  "version": "0.4.0",
  "description": "Pi toolkit with Janitor cleanup, Code Simplifier refinement, and blocking serial worker/reviewer delegation.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edepree/pi-toolkit.git"
  },
  "files": [
    "skills",
    "extensions",
    "lib",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions/serial-subagent.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.7",
    "@types/node": "26.0.0",
    "typescript": "6.0.2",
    "@earendil-works/pi-tui": "0.85.1"
  }
}
